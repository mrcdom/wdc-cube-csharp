<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Cube tutorial · Blazor</title>
    <link rel="stylesheet" href="app.css" />
    <HeadOutlet @rendermode="Interactive" />
</head>
<body>
    @* Interactive router: changing the address re-renders the same page instead of reloading it. *@
    <Routes @rendermode="Interactive" />
    <script src="_framework/blazor.web.js"></script>
</body>
</html>

@code {
    private static readonly IComponentRenderMode Interactive = new InteractiveServerRenderMode(prerender: false);
}
