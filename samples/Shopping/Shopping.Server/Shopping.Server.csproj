<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- The Shopping backend over HTTP: the repositories as REST routes, remote transactions and JWT login,
       for clients that run the presentation themselves (the Avalonia desktop app). -->
  <ItemGroup>
    <ProjectReference Include="../Shopping.Persistence/Shopping.Persistence.csproj" />
    <ProjectReference Include="../Shopping.Hosting/Shopping.Hosting.csproj" />
    <ProjectReference Include="../../../src/Wdc.Rest.Server/Wdc.Rest.Server.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
  </ItemGroup>
  <!-- The WebAssembly app it serves is built for net11.0 only. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <ProjectReference Include="../Shopping.Wasm/Shopping.Wasm.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Shopping.Presentation.Tests" />
  </ItemGroup>
</Project>
