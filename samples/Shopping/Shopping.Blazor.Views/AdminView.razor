@inherits ScopeView<AdminScope>

@if (Scope.Content is { } content)
{
    <ViewSlot Scope="content" />
}
else
{
    <section class="card admin-page">
        <h2>@T(MessageKeys.AdminTitle) <span class="chip">@T(Scope.CountLabel)</span></h2>
        <form class="admin-filter" @onsubmit="() => Scope.OnFilter(_customer)" @onsubmit:preventDefault>
            <input class="customer" placeholder="@T(MessageKeys.AdminCustomerName)" value="@_customer"
                   @oninput="e => _customer = e.Value?.ToString() ?? string.Empty" />
            <button class="outlined filter" type="submit">@T(MessageKeys.AdminFilter)</button>
        </form>
        @if (!Scope.Loading && Scope.Purchases.Count == 0)
        {
            <p class="muted">@T(MessageKeys.AdminEmpty)</p>
        }
        @foreach (var purchase in Scope.Purchases)
        {
            <button @key="purchase.Id" class="admin-row" @onclick="() => Scope.OnOpenPurchase(purchase.Id)">
                <span class="number">@T(purchase.NumberLabel)</span>
                <span class="customer">@purchase.CustomerLabel</span>
                <span class="date">@T(purchase.DateLabel)</span>
                <span class="items">@purchase.ItemsLabel</span>
                <span class="price">@purchase.TotalLabel</span>
                @if (purchase.Corrected)
                {
                    <span class="chip corrected">@T(MessageKeys.AdminCorrected)</span>
                }
            </button>
        }
        <nav class="pager">
            <button class="previous" disabled="@(!Scope.HasPrevious)" @onclick="Scope.OnPrevious">◀ @T(MessageKeys.CommonPrevious)</button>
            <span class="page">@T(Scope.PageLabel)</span>
            <button class="next" disabled="@(!Scope.HasNext)" @onclick="Scope.OnNext">@T(MessageKeys.CommonNext) ▶</button>
        </nav>
        <div class="actions">
            <button class="outlined back" @onclick="Scope.OnBack">@T(MessageKeys.CommonBack)</button>
        </div>
    </section>
}

@code {
    // What is being typed: view plumbing; the presenter receives it on submit.
    private string _customer = string.Empty;
    private string? _shown;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (_shown != Scope.CustomerFilter)
        {
            _shown = Scope.CustomerFilter; // the filter that came from the address
            _customer = Scope.CustomerFilter;
        }
    }
}
