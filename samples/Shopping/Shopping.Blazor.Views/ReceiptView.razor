@inherits ScopeView<ReceiptScope>

<section class="card receipt-page">
    @if (Scope.NotifySuccess)
    {
        <p class="success">Compra realizada com sucesso!</p>
    }
    <h2>🧾 Recibo <span class="chip">@Scope.DateLabel</span></h2>
    <table>
        <thead><tr><th>Item</th><th>Qtd</th><th>Valor</th></tr></thead>
        <tbody>
            @foreach (var line in Scope.Lines)
            {
                <tr><td>@line.Description</td><td class="qty">@line.Quantity</td><td class="value">@line.ValueLabel</td></tr>
            }
        </tbody>
    </table>
    <p class="total">Total: <strong>@Scope.TotalLabel</strong></p>
    @foreach (var correction in Scope.Corrections)
    {
        <p class="correction">@correction</p>
    }
    <div class="actions">
        <button class="primary continue" @onclick="Scope.OnContinue">Continuar Comprando</button>
    </div>
</section>
