@inherits ScopeView<ReceiptScope>

<section class="card receipt-page">
    @if (Scope.NotifySuccess)
    {
        <p class="success">@T(MessageKeys.ReceiptPurchaseCompleted)</p>
    }
    <h2>🧾 @T(MessageKeys.ReceiptTitle) <span class="chip">@T(Scope.DateLabel)</span></h2>
    <table>
        <thead><tr><th>@T(MessageKeys.CommonItem)</th><th>@T(MessageKeys.CommonQuantity)</th><th>@T(MessageKeys.ReceiptAmount)</th></tr></thead>
        <tbody>
            @foreach (var line in Scope.Lines)
            {
                <tr><td>@line.Description</td><td class="qty">@line.Quantity</td><td class="value">@line.ValueLabel</td></tr>
            }
        </tbody>
    </table>
    <p class="total">@T(MessageKeys.CommonTotal) <strong>@Scope.TotalLabel</strong></p>
    @foreach (var correction in Scope.Corrections)
    {
        <p class="correction">@T(correction)</p>
    }
    <div class="actions">
        <button class="primary continue" @onclick="Scope.OnContinue">@T(MessageKeys.CommonContinueShopping)</button>
    </div>
</section>
