@inherits ScopeView<ReceiptScope>

<section class="card receipt-page">
    @if (Scope.NotifySuccess)
    {
        <p class="success">Purchase completed successfully!</p>
    }
    <h2>🧾 Receipt <span class="chip">@T(Scope.DateLabel)</span></h2>
    <table>
        <thead><tr><th>Item</th><th>Qty</th><th>Amount</th></tr></thead>
        <tbody>
            @foreach (var line in Scope.Lines)
            {
                <tr><td>@line.Description</td><td class="qty">@line.Quantity</td><td class="value">@line.ValueLabel</td></tr>
            }
        </tbody>
    </table>
    <p class="total">Total: <strong>@Scope.TotalLabel</strong></p>
    @foreach (var correction in Scope.Corrections)
    {
        <p class="correction">@T(correction)</p>
    }
    <div class="actions">
        <button class="primary continue" @onclick="Scope.OnContinue">Continue Shopping</button>
    </div>
</section>
