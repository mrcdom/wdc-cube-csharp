@inherits ScopeView<AmendScope>

<section class="card amend-page">
    <h2>@T(Scope.TitleLabel) <span class="chip">@T(Scope.DateLabel)</span></h2>
    <p class="customer">Customer: <strong>@Scope.CustomerLabel</strong></p>
    @if (Scope.SuccessMessage is { } success)
    {
        <p class="success">@T(success)</p>
    }
    @if (Scope.ErrorMessage is { } error)
    {
        <p class="error">@T(error)</p>
    }
    <table>
        <thead><tr><th>Item</th><th>Price</th><th>Qty</th><th>New qty</th></tr></thead>
        <tbody>
            @foreach (var line in Scope.Lines)
            {
                <AmendLineView @key="line.Identity" Scope="line" />
            }
        </tbody>
    </table>
    <p class="total">Total: @Scope.TotalLabel → <strong>@Scope.NewTotalLabel</strong></p>
    <label class="reason">Reason
        <textarea rows="2" value="@Scope.Reason" disabled="@Scope.Saving"
                  @oninput="e => Scope.OnChangeReason(e.Value?.ToString() ?? string.Empty)"></textarea>
    </label>
    <div class="actions">
        <button class="outlined back" @onclick="Scope.OnBack">Back</button>
        <button class="primary confirm" disabled="@(!Scope.CanConfirm || Scope.Saving)" @onclick="Scope.OnConfirm">
            @(Scope.Saving ? "Recording…" : "Record correction")
        </button>
    </div>
    @if (Scope.History.Count > 0)
    {
        <h3>Previous corrections</h3>
        <ul class="history">
            @foreach (var entry in Scope.History)
            {
                <li>
                    <span class="when">@T(entry.DateLabel) — @entry.AuthorLabel</span>
                    <span class="why">@entry.Reason</span>
                    <span class="what muted">@string.Join("; ", entry.Changes.Select(T))</span>
                </li>
            }
        </ul>
    }
</section>
