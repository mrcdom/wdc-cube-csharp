@inherits ScopeView<ProductsPanelScope>

<section class="card products-panel">
    <h2>@T(MessageKeys.ProductsTitle) <span class="chip">@T(Scope.CountLabel)</span></h2>
    @if (Scope.Loading && Scope.Products.Count == 0)
    {
        <p class="muted">@T(MessageKeys.ProductsLoading)</p>
    }
    else if (Scope.Products.Count == 0)
    {
        <p class="muted">@T(MessageKeys.ProductsEmpty)</p>
    }
    <div class="product-grid">
        @foreach (var product in Scope.Products)
        {
            <button @key="product.Id" class="product-card" @onclick="() => Scope.OnOpenProduct(product.Id)">
                <img src="@product.ImageUrl" alt="" loading="lazy" />
                <span class="name">@product.Name</span>
                <span class="price">@product.PriceLabel</span>
            </button>
        }
    </div>
</section>
