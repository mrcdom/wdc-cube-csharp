@inherits ScopeView<CartScope>

<section class="card cart-page">
    <h2>Shopping Cart</h2>
    @if (Scope.ErrorMessage is { } error)
    {
        <p class="error">@T(error)</p>
    }
    @if (Scope.Lines.Count == 0)
    {
        <div class="empty">
            <p class="big">🛒</p>
            <p>Your cart is empty</p>
            <p class="muted">Add products to start shopping</p>
        </div>
    }
    else
    {
        @foreach (var line in Scope.Lines)
        {
            <CartLineView @key="line.Identity" Scope="line" />
        }
        <p class="total">Total: <strong>@Scope.TotalLabel</strong></p>
    }
    <div class="actions">
        <button class="outlined continue" @onclick="Scope.OnContinue">Continue Shopping</button>
        @if (Scope.Lines.Count > 0)
        {
            <button class="buy" disabled="@Scope.Buying" @onclick="Scope.OnBuy">@(Scope.Buying ? "Buying…" : "Buy")</button>
        }
    </div>
</section>
