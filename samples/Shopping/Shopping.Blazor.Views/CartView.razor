@inherits ScopeView<CartScope>

<section class="card cart-page">
    <h2>@T(MessageKeys.CartTitle)</h2>
    @if (Scope.ErrorMessage is { } error)
    {
        <p class="error">@T(error)</p>
    }
    @if (Scope.Lines.Count == 0)
    {
        <div class="empty">
            <p class="big">🛒</p>
            <p>@T(MessageKeys.CartEmptyTitle)</p>
            <p class="muted">@T(MessageKeys.CartEmptyHint)</p>
        </div>
    }
    else
    {
        @foreach (var line in Scope.Lines)
        {
            <CartLineView @key="line.Identity" Scope="line" />
        }
        <p class="total">@T(MessageKeys.CommonTotal) <strong>@Scope.TotalLabel</strong></p>
    }
    <div class="actions">
        <button class="outlined continue" @onclick="Scope.OnContinue">@T(MessageKeys.CommonContinueShopping)</button>
        @if (Scope.Lines.Count > 0)
        {
            <button class="buy" disabled="@Scope.Buying" @onclick="Scope.OnBuy">@T(Scope.Buying ? MessageKeys.CartBuying : MessageKeys.CartBuy)</button>
        }
    </div>
</section>
