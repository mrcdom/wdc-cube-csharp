<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <!-- The Shopping demo in the browser: the presentation runs in WebAssembly and talks to
       Shopping.Server through Shopping.Client. Served by Shopping.Server, same origin. -->
  <PropertyGroup>
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net11.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Shopping.Blazor.Views/Shopping.Blazor.Views.csproj" />
    <ProjectReference Include="../Shopping.Client/Shopping.Client.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
  </ItemGroup>
</Project>
