{
  "$description": "The look of the Shopping sample, for every renderer. Edit here, then run samples/Shopping/generate.cs: it writes Shopping.Blazor.Views/wwwroot/tokens.css and Shopping.Avalonia/Tokens.axaml. Colors are #RRGGBB or #RRGGBBAA.",
  "color": {
    "$type": "color",
    "primary": { "$value": "#1B5E7B" },
    "primaryHover": { "$value": "#174F68" },
    "primaryContainer": { "$value": "#D0E8F2" },
    "onPrimary": { "$value": "#FFFFFF" },
    "onPrimaryLine": { "$value": "#FFFFFF80" },
    "onPrimaryHover": { "$value": "#FFFFFF1A" },
    "bg": { "$value": "#F5F7F9" },
    "surface": { "$value": "#FFFFFF" },
    "hover": { "$value": "#F1F3F4" },
    "fg": { "$value": "#1C1B1F" },
    "muted": { "$value": "#5F6368" },
    "line": { "$value": "#DADCE0" },
    "price": { "$value": "#2E7D32" },
    "priceHover": { "$value": "#276B2B" },
    "error": { "$value": "#B3261E" },
    "successBg": { "$value": "#E6F4EA" },
    "toast": { "$value": "#333333E6" }
  },
  "space": {
    "$type": "dimension",
    "xxs": { "$value": "2px" },
    "xs": { "$value": "4px" },
    "sm": { "$value": "8px" },
    "md": { "$value": "12px" },
    "lg": { "$value": "16px" },
    "xl": { "$value": "32px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "8px" },
    "md": { "$value": "12px" },
    "lg": { "$value": "16px" }
  },
  "fontSize": {
    "$type": "dimension",
    "xs": { "$value": "12px" },
    "sm": { "$value": "13px" },
    "md": { "$value": "14px" },
    "body": { "$value": "15px" },
    "lg": { "$value": "18px" },
    "xl": { "$value": "28px" },
    "display": { "$value": "40px" }
  },
  "fontWeight": {
    "$type": "fontWeight",
    "medium": { "$value": 500 },
    "semibold": { "$value": 600 },
    "bold": { "$value": 700 }
  },
  "fontFamily": {
    "$type": "fontFamily",
    "body": { "$value": ["system-ui", "-apple-system", "Segoe UI", "sans-serif"] }
  }
}
