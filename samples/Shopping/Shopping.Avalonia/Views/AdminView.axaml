<cube:ScopeView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:cube="using:Wdc.Cube.Avalonia"
                xmlns:m="using:Shopping.Presentation.Modules.Home.Admin"
                xmlns:v="using:Shopping.Avalonia.Views"
                x:Class="Shopping.Avalonia.Views.AdminView"
                x:DataType="m:AdminScope">
  <Panel>
    <ContentControl Content="{Binding Content}" IsVisible="{Binding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <Border Classes="card" IsVisible="{Binding Content, Converter={x:Static ObjectConverters.IsNull}}">
      <StackPanel Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="h2" Text="{v:T admin.title}" />
          <Border Classes="chip"><TextBlock Text="{Binding CountLabel, Converter={StaticResource T}}" /></Border>
        </StackPanel>
        <DockPanel>
          <Button DockPanel.Dock="Right" Classes="outlined" Content="{v:T admin.filter}" Margin="8,0,0,0" Click="OnFilter" />
          <TextBox x:Name="CustomerBox" PlaceholderText="{v:T admin.customerName}" KeyDown="OnCustomerKey" />
        </DockPanel>
        <TextBlock Classes="muted" Text="{v:T admin.empty}"
                   IsVisible="{Binding Purchases, Converter={x:Static v:Is.Empty}}" />
        <ItemsControl x:Name="Rows" ItemsSource="{Binding Purchases}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="m:AdminPurchaseRow">
              <Button Classes="purchase-card" Click="OnOpen">
                <Grid ColumnDefinitions="70,*,100,Auto">
                  <TextBlock Classes="muted" Text="{Binding NumberLabel, Converter={StaticResource T}}" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding CustomerLabel}" FontWeight="{StaticResource FontWeightSemibold}" />
                    <TextBlock Classes="muted" Text="{Binding ItemsLabel}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="2">
                    <TextBlock Classes="muted" Text="{Binding DateLabel, Converter={StaticResource T}}" TextAlignment="Right" />
                    <TextBlock Classes="price" Text="{Binding TotalLabel}" TextAlignment="Right" />
                  </StackPanel>
                  <Border Grid.Column="3" Classes="chip" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{Binding Corrected}">
                    <TextBlock Text="{v:T admin.corrected}" />
                  </Border>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <DockPanel>
          <Button DockPanel.Dock="Left" IsEnabled="{Binding HasPrevious}" Click="OnPrevious"><TextBlock><Run Text="◀ " /><Run Text="{v:T common.previous}" /></TextBlock></Button>
          <Button DockPanel.Dock="Right" IsEnabled="{Binding HasNext}" Click="OnNext"><TextBlock><Run Text="{v:T common.next}" /><Run Text=" ▶" /></TextBlock></Button>
          <TextBlock Text="{Binding PageLabel, Converter={StaticResource T}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </DockPanel>
        <Button Classes="outlined" Content="{v:T common.back}" HorizontalAlignment="Right" Click="OnBack" />
      </StackPanel>
    </Border>
  </Panel>
</cube:ScopeView>
