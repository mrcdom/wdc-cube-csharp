<cube:ScopeView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:cube="using:Wdc.Cube.Avalonia"
                xmlns:m="using:Shopping.Presentation.Modules.Home"
                xmlns:v="using:Shopping.Avalonia.Views"
                x:Class="Shopping.Avalonia.Views.HomeView"
                x:DataType="m:HomeScope">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource Primary}" Padding="16,8">
      <DockPanel>
        <Button DockPanel.Dock="Left" Classes="logo" Padding="4,4" Click="OnHome">
          <TextBlock Text="🛍 Shopping" FontSize="18" FontWeight="Bold" Foreground="White" />
        </Button>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="12">
          <Panel>
            <Button x:Name="CartButton" Classes="onPrimary" Click="OnCart" ToolTip.Tip="Carrinho">
              <TextBlock Text="🛒" />
            </Button>
            <Border Background="{StaticResource Error}" CornerRadius="10" Padding="6,0" Margin="0,-6,-6,0"
                    HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False"
                    IsVisible="{Binding CartCount, Converter={x:Static v:Is.Positive}}">
              <TextBlock x:Name="CartBadge" Text="{Binding CartCount}" Foreground="White" FontSize="11" />
            </Border>
          </Panel>
          <Button Classes="onPrimary" Click="OnExit"><TextBlock Text="Sair" FontWeight="SemiBold" /></Button>
        </StackPanel>
        <TextBlock x:Name="Greeting" Text="{Binding Greeting}" Foreground="White" VerticalAlignment="Center"
                   Margin="12,0" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
    <ScrollViewer>
      <Panel MaxWidth="1100" Margin="16" HorizontalAlignment="Stretch" VerticalAlignment="Top">
        <ContentControl Content="{Binding Content}" IsVisible="{Binding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Grid ColumnDefinitions="3*,16,2*" IsVisible="{Binding Content, Converter={x:Static ObjectConverters.IsNull}}">
          <ContentControl Grid.Column="0" Content="{Binding Products}" VerticalAlignment="Top" />
          <ContentControl Grid.Column="2" Content="{Binding Purchases}" VerticalAlignment="Top" />
        </Grid>
      </Panel>
    </ScrollViewer>
  </DockPanel>
</cube:ScopeView>
