<cube:ScopeView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:cube="using:Wdc.Cube.Avalonia"
                xmlns:m="using:Shopping.Presentation.Modules.Home"
                xmlns:v="using:Shopping.Avalonia.Views"
                x:Class="Shopping.Avalonia.Views.HomeView"
                x:DataType="m:HomeScope">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="White" Padding="16,10" BoxShadow="0 1 3 0 #22000000">
      <DockPanel>
        <Button DockPanel.Dock="Left" Content="🛍 Shopping" FontWeight="SemiBold" Background="Transparent" Click="OnHome" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button x:Name="CartButton" Click="OnCart" ToolTip.Tip="Carrinho">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="🛒" />
              <Border Background="#DC2626" CornerRadius="9" Padding="6,0" IsVisible="{Binding CartCount, Converter={x:Static v:Is.Positive}}">
                <TextBlock x:Name="CartBadge" Text="{Binding CartCount}" Foreground="White" FontSize="12" />
              </Border>
            </StackPanel>
          </Button>
          <Button Content="Sair" Click="OnExit" />
        </StackPanel>
        <TextBlock x:Name="Greeting" Text="{Binding Greeting}" VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
    <ScrollViewer Padding="16">
      <Panel>
        <ContentControl Content="{Binding Content}" IsVisible="{Binding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Grid ColumnDefinitions="2*,16,*" IsVisible="{Binding Content, Converter={x:Static ObjectConverters.IsNull}}">
          <ContentControl Grid.Column="0" Content="{Binding Products}" />
          <ContentControl Grid.Column="2" Content="{Binding Purchases}" />
        </Grid>
      </Panel>
    </ScrollViewer>
  </DockPanel>
</cube:ScopeView>
