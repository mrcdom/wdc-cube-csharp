<cube:ScopeView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:cube="using:Wdc.Cube.Avalonia"
                xmlns:m="using:Shopping.Presentation.Modules.Home.Admin.Amend"
                x:Class="Shopping.Avalonia.Views.AmendLineView"
                x:DataType="m:AmendLineScope">
  <Border Classes="row">
    <Grid ColumnDefinitions="*,100,60,130">
      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="Wrap" />
      <TextBlock Grid.Column="1" Text="{Binding PriceLabel}" TextAlignment="Right" VerticalAlignment="Center" />
      <TextBlock Grid.Column="2" Text="{Binding Quantity}" TextAlignment="Right" VerticalAlignment="Center" />
      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="−" Click="OnMinus" />
        <TextBlock x:Name="NewQuantity" Text="{Binding NewQuantity}" FontWeight="{StaticResource FontWeightSemibold}" VerticalAlignment="Center"
                   MinWidth="24" TextAlignment="Center" />
        <Button Content="+" Click="OnPlus" />
      </StackPanel>
    </Grid>
  </Border>
</cube:ScopeView>
