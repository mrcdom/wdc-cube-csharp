<cube:ScopeView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:cube="using:Wdc.Cube.Avalonia"
                xmlns:m="using:Shopping.Presentation.Modules.Home.ProductDetail"
                xmlns:v="using:Shopping.Avalonia.Views"
                x:Class="Shopping.Avalonia.Views.ProductView"
                x:DataType="m:ProductScope">
  <Border Classes="card">
    <StackPanel Spacing="12">
      <TextBlock Classes="error" Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <Grid ColumnDefinitions="Auto,24,*">
        <Image Width="260" Height="220" Stretch="Uniform" v:RemoteImage.Url="{Binding ImageUrl}" />
        <StackPanel Grid.Column="2" Spacing="8">
          <TextBlock x:Name="ProductName" Classes="title" Text="{Binding Name}" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding DescriptionItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="price" FontSize="18" Text="{Binding PriceLabel}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Qtd:" VerticalAlignment="Center" />
            <Button Content="−" Click="OnMinus" />
            <TextBlock x:Name="Quantity" Text="1" VerticalAlignment="Center" MinWidth="24" TextAlignment="Center" />
            <Button Content="+" Click="OnPlus" />
          </StackPanel>
        </StackPanel>
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Voltar" Click="OnBack" />
        <Button x:Name="AddButton" Classes="primary" Content="🛒 Adicionar" Click="OnAdd" />
      </StackPanel>
    </StackPanel>
  </Border>
</cube:ScopeView>
