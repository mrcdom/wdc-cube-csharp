<cube:ScopeView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:cube="using:Wdc.Cube.Avalonia"
                xmlns:m="using:Shopping.Presentation.Modules.Home.ProductDetail"
                xmlns:v="using:Shopping.Avalonia.Views"
                x:Class="Shopping.Avalonia.Views.ProductView"
                x:DataType="m:ProductScope">
  <Border Classes="card">
    <StackPanel Spacing="16">
      <TextBlock Classes="error" Text="{Binding ErrorMessage, Converter={StaticResource T}}" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <Grid ColumnDefinitions="120,16,*">
        <Image Width="120" Height="120" Stretch="Uniform" VerticalAlignment="Top" v:RemoteImage.Url="{Binding ImageUrl}" />
        <StackPanel Grid.Column="2" Spacing="12">
          <TextBlock x:Name="ProductName" Text="{Binding Name}" FontSize="26" FontWeight="{StaticResource FontWeightBold}" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding DescriptionItems}" Margin="4,0,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Classes="muted" Text="{Binding StringFormat=•  {0}}" TextWrapping="Wrap" Margin="0,1" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="price" Text="{Binding PriceLabel}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{v:T product.quantity}" VerticalAlignment="Center" />
            <Button Content="−" Click="OnMinus" />
            <TextBlock x:Name="Quantity" Text="1" FontWeight="{StaticResource FontWeightSemibold}" VerticalAlignment="Center" MinWidth="24" TextAlignment="Center" />
            <Button Content="+" Click="OnPlus" />
          </StackPanel>
        </StackPanel>
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Classes="outlined" Content="{v:T common.back}" Click="OnBack" />
        <Button x:Name="AddButton" Classes="primary" Click="OnAdd"><TextBlock><Run Text="🛒 " /><Run Text="{v:T product.addToCart}" /></TextBlock></Button>
      </StackPanel>
    </StackPanel>
  </Border>
</cube:ScopeView>
