<cube:ScopeView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:cube="using:Wdc.Cube.Avalonia"
                xmlns:m="using:Shopping.Presentation.Modules.Home.Products"
                xmlns:v="using:Shopping.Avalonia.Views"
                x:Class="Shopping.Avalonia.Views.ProductsPanelView"
                x:DataType="m:ProductsPanelScope">
  <Border Classes="card">
    <StackPanel Spacing="12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Classes="h2" Text="Produtos" />
        <Border Classes="chip"><TextBlock Text="{Binding CountLabel}" /></Border>
      </StackPanel>
      <TextBlock Classes="muted" Text="Carregando…" IsVisible="{Binding Loading}" />
      <ItemsControl x:Name="Grid" ItemsSource="{Binding Products}" Margin="0,0,-12,-12">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel ItemWidth="203" ItemHeight="250" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="m:ProductCard">
            <Button Classes="product-card" Margin="0,0,12,12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="OnOpen">
              <StackPanel Spacing="6">
                <Image Height="140" Stretch="Uniform" v:RemoteImage.Url="{Binding ImageUrl}" />
                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock Classes="price" Text="{Binding PriceLabel}" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</cube:ScopeView>
