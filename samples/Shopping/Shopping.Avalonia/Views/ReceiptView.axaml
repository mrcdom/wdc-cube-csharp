<cube:ScopeView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:cube="using:Wdc.Cube.Avalonia"
                xmlns:m="using:Shopping.Presentation.Modules.Home.Receipt"
                xmlns:v="using:Shopping.Avalonia.Views"
                x:Class="Shopping.Avalonia.Views.ReceiptView"
                x:DataType="m:ReceiptScope">
  <Border Classes="card">
    <StackPanel Spacing="12">
      <Border Classes="success" Margin="0,16,0,0" IsVisible="{Binding NotifySuccess}">
        <TextBlock Text="Compra realizada com sucesso!" />
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Classes="h2" Text="🧾 Recibo" />
        <Border Classes="chip"><TextBlock Text="{Binding DateLabel}" /></Border>
      </StackPanel>
      <StackPanel>
        <Border Classes="row">
          <Grid ColumnDefinitions="*,Auto,370">
            <TextBlock Text="Item" FontWeight="Bold" />
            <TextBlock Grid.Column="1" Text="Qtd" FontWeight="Bold" TextAlignment="Right" />
            <TextBlock Grid.Column="2" Text="Valor" FontWeight="Bold" TextAlignment="Right" />
          </Grid>
        </Border>
        <ItemsControl x:Name="Lines" ItemsSource="{Binding Lines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="m:ReceiptLine">
              <Border Classes="row">
                <Grid ColumnDefinitions="*,Auto,370">
                  <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="1" Text="{Binding Quantity}" TextAlignment="Right" MinWidth="32" />
                  <TextBlock Grid.Column="2" Text="{Binding ValueLabel}" TextAlignment="Right" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <TextBlock Text="Total: " FontSize="18" />
        <TextBlock x:Name="Total" Text="{Binding TotalLabel}" FontSize="18" FontWeight="Bold" />
      </StackPanel>
      <Button Classes="primary" Content="Continuar Comprando" HorizontalAlignment="Right" Click="OnContinue" />
    </StackPanel>
  </Border>
</cube:ScopeView>
