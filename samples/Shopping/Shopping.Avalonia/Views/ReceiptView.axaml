<cube:ScopeView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:cube="using:Wdc.Cube.Avalonia"
                xmlns:m="using:Shopping.Presentation.Modules.Home.Receipt"
                xmlns:v="using:Shopping.Avalonia.Views"
                xmlns:wdc="using:Wdc.Cube"
                x:Class="Shopping.Avalonia.Views.ReceiptView"
                x:DataType="m:ReceiptScope">
  <Border Classes="card">
    <StackPanel Spacing="12">
      <Border Classes="success" Margin="0,16,0,0" IsVisible="{Binding NotifySuccess}">
        <TextBlock Text="{v:T receipt.purchaseCompleted}" />
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Classes="h2"><Run Text="🧾 " /><Run Text="{v:T receipt.title}" /></TextBlock>
        <Border Classes="chip"><TextBlock Text="{Binding DateLabel, Converter={StaticResource T}}" /></Border>
      </StackPanel>
      <StackPanel>
        <Border Classes="row">
          <Grid ColumnDefinitions="*,Auto,370">
            <TextBlock Text="{v:T common.item}" FontWeight="{StaticResource FontWeightBold}" />
            <TextBlock Grid.Column="1" Text="{v:T common.quantity}" FontWeight="{StaticResource FontWeightBold}" TextAlignment="Right" />
            <TextBlock Grid.Column="2" Text="{v:T receipt.amount}" FontWeight="{StaticResource FontWeightBold}" TextAlignment="Right" />
          </Grid>
        </Border>
        <ItemsControl x:Name="Lines" ItemsSource="{Binding Lines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="m:ReceiptLine">
              <Border Classes="row">
                <Grid ColumnDefinitions="*,Auto,370">
                  <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="1" Text="{Binding Quantity}" TextAlignment="Right" MinWidth="32" />
                  <TextBlock Grid.Column="2" Text="{Binding ValueLabel}" TextAlignment="Right" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <TextBlock Text="{v:T common.total}" Margin="0,0,4,0" FontSize="{StaticResource FontSizeLg}" />
        <TextBlock x:Name="Total" Text="{Binding TotalLabel}" FontSize="{StaticResource FontSizeLg}" FontWeight="{StaticResource FontWeightBold}" />
      </StackPanel>
      <ItemsControl x:Name="Corrections" ItemsSource="{Binding Corrections}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="wdc:Message">
            <Border Classes="chip" Padding="10,6" Margin="0,4,0,0" HorizontalAlignment="Stretch">
              <TextBlock Text="{Binding Converter={StaticResource T}}" TextWrapping="Wrap" />
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Classes="primary" Content="{v:T common.continueShopping}" HorizontalAlignment="Right" Click="OnContinue" />
    </StackPanel>
  </Border>
</cube:ScopeView>
