<cube:ScopeView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:cube="using:Wdc.Cube.Avalonia"
                xmlns:m="using:Shopping.Presentation.Modules.Home.Admin.Amend"
                xmlns:v="using:Shopping.Avalonia.Views"
                x:Class="Shopping.Avalonia.Views.AmendView"
                x:DataType="m:AmendScope">
  <Border Classes="card">
    <StackPanel Spacing="12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Classes="h2" Text="{Binding TitleLabel}" />
        <Border Classes="chip"><TextBlock Text="{Binding DateLabel}" /></Border>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="4">
        <TextBlock Classes="muted" Text="Cliente:" />
        <TextBlock Text="{Binding CustomerLabel}" FontWeight="SemiBold" />
      </StackPanel>
      <Border Classes="success" IsVisible="{Binding SuccessMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock x:Name="Success" Text="{Binding SuccessMessage}" />
      </Border>
      <TextBlock x:Name="Error" Classes="error" Text="{Binding ErrorMessage}"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <StackPanel>
        <Border Classes="row">
          <Grid ColumnDefinitions="*,100,60,130">
            <TextBlock Text="Item" FontWeight="Bold" />
            <TextBlock Grid.Column="1" Text="Preço" FontWeight="Bold" TextAlignment="Right" />
            <TextBlock Grid.Column="2" Text="Qtd" FontWeight="Bold" TextAlignment="Right" />
            <TextBlock Grid.Column="3" Text="Nova qtd" FontWeight="Bold" TextAlignment="Right" />
          </Grid>
        </Border>
        <ItemsControl x:Name="LinesList" ItemsSource="{Binding Lines}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
        <TextBlock Text="Total:" FontSize="18" />
        <TextBlock Text="{Binding TotalLabel}" FontSize="18" />
        <TextBlock Text="→" FontSize="18" />
        <TextBlock x:Name="NewTotal" Text="{Binding NewTotalLabel}" FontSize="18" FontWeight="Bold" />
      </StackPanel>
      <StackPanel Spacing="4">
        <TextBlock Classes="muted" Text="Motivo" />
        <TextBox x:Name="ReasonBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"
                 IsEnabled="{Binding !Saving}" TextChanged="OnReasonChanged" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Classes="outlined" Content="Voltar" Click="OnBack" />
        <Button x:Name="ConfirmButton" Classes="primary" Click="OnConfirm">
          <Button.IsEnabled>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="CanConfirm" />
              <Binding Path="!Saving" />
            </MultiBinding>
          </Button.IsEnabled>
          <Panel>
            <TextBlock Text="Registrar correção" IsVisible="{Binding !Saving}" />
            <TextBlock Text="Registrando…" IsVisible="{Binding Saving}" />
          </Panel>
        </Button>
      </StackPanel>
      <StackPanel Spacing="8" IsVisible="{Binding History, Converter={x:Static v:Is.NotEmpty}}">
        <TextBlock Text="Correções anteriores" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
        <ItemsControl x:Name="HistoryList" ItemsSource="{Binding History}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="m:AmendmentEntry">
              <Border Classes="row">
                <StackPanel Spacing="2">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="muted" Text="{Binding DateLabel}" />
                    <TextBlock Classes="muted" Text="—" />
                    <TextBlock Classes="muted" Text="{Binding AuthorLabel}" />
                  </StackPanel>
                  <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding Changes}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </Border>
</cube:ScopeView>
