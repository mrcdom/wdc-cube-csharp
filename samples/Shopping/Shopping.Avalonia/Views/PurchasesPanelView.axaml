<cube:ScopeView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:cube="using:Wdc.Cube.Avalonia"
                xmlns:m="using:Shopping.Presentation.Modules.Home.Purchases"
                xmlns:v="using:Shopping.Avalonia.Views"
                x:Class="Shopping.Avalonia.Views.PurchasesPanelView"
                x:DataType="m:PurchasesPanelScope">
  <Border Classes="card">
    <StackPanel Spacing="12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Classes="h2" Text="{v:T purchases.title}" />
        <Border Classes="chip"><TextBlock Text="{Binding CountLabel, Converter={StaticResource T}}" /></Border>
      </StackPanel>
      <TextBlock Classes="muted" Text="{v:T purchases.empty}"
                 IsVisible="{Binding Purchases, Converter={x:Static v:Is.Empty}}" />
      <ItemsControl ItemsSource="{Binding Purchases}" Margin="0,0,0,-10">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="m:PurchaseCard">
            <Button Classes="purchase-card" Click="OnOpen">
              <StackPanel Spacing="2">
                <TextBlock Classes="muted" FontSize="{StaticResource FontSizeXs}" Text="{Binding DateLabel, Converter={StaticResource T}}" />
                <TextBlock Text="{Binding ItemsLabel}" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="price" Text="{Binding TotalLabel}" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <DockPanel>
        <Button DockPanel.Dock="Left" IsEnabled="{Binding HasPrevious}" Click="OnPrevious"><TextBlock><Run Text="◀ " /><Run Text="{v:T common.previous}" /></TextBlock></Button>
        <Button DockPanel.Dock="Right" IsEnabled="{Binding HasNext}" Click="OnNext"><TextBlock><Run Text="{v:T common.next}" /><Run Text=" ▶" /></TextBlock></Button>
        <TextBlock x:Name="PageLabel" Text="{Binding PageLabel, Converter={StaticResource T}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </DockPanel>
    </StackPanel>
  </Border>
</cube:ScopeView>
