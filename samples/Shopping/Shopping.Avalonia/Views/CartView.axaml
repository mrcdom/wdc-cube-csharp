<cube:ScopeView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:cube="using:Wdc.Cube.Avalonia"
                xmlns:m="using:Shopping.Presentation.Modules.Home.Cart"
                xmlns:v="using:Shopping.Avalonia.Views"
                x:Class="Shopping.Avalonia.Views.CartView"
                x:DataType="m:CartScope">
  <Border Classes="card">
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Carrinho de Compras" />
      <TextBlock Classes="error" Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <StackPanel IsVisible="{Binding Lines, Converter={x:Static v:Is.Empty}}" HorizontalAlignment="Center" Spacing="4">
        <TextBlock Text="🛒" FontSize="40" HorizontalAlignment="Center" />
        <TextBlock Text="Seu carrinho está vazio" HorizontalAlignment="Center" />
        <TextBlock Classes="muted" Text="Adicione produtos para continuar" HorizontalAlignment="Center" />
      </StackPanel>
      <ItemsControl x:Name="LinesList" ItemsSource="{Binding Lines}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" IsVisible="{Binding Lines, Converter={x:Static v:Is.NotEmpty}}">
        <TextBlock Text="Total: " FontSize="18" />
        <TextBlock x:Name="Total" Text="{Binding TotalLabel}" FontSize="18" FontWeight="Bold" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
        <Button Classes="outlined" Content="Continuar Comprando" Click="OnContinue" />
        <Button x:Name="BuyButton" Classes="buy" IsEnabled="{Binding !Buying}" Click="OnBuy"
                IsVisible="{Binding Lines, Converter={x:Static v:Is.NotEmpty}}">
          <Panel>
            <TextBlock Text="Comprar" FontWeight="SemiBold" IsVisible="{Binding !Buying}" />
            <TextBlock Text="Comprando…" FontWeight="SemiBold" IsVisible="{Binding Buying}" />
          </Panel>
        </Button>
      </StackPanel>
    </StackPanel>
  </Border>
</cube:ScopeView>
