<cube:ScopeView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:cube="using:Wdc.Cube.Avalonia"
                xmlns:m="using:Shopping.Presentation.Modules.Home.Cart"
                xmlns:v="using:Shopping.Avalonia.Views"
                x:Class="Shopping.Avalonia.Views.CartView"
                x:DataType="m:CartScope">
  <Border Classes="card">
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Shopping Cart" />
      <TextBlock Classes="error" Text="{Binding ErrorMessage, Converter={StaticResource T}}" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <StackPanel IsVisible="{Binding Lines, Converter={x:Static v:Is.Empty}}" HorizontalAlignment="Center" Spacing="4">
        <TextBlock Text="🛒" FontSize="{StaticResource FontSizeDisplay}" HorizontalAlignment="Center" />
        <TextBlock Text="Your cart is empty" HorizontalAlignment="Center" />
        <TextBlock Classes="muted" Text="Add products to start shopping" HorizontalAlignment="Center" />
      </StackPanel>
      <ItemsControl x:Name="LinesList" ItemsSource="{Binding Lines}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" IsVisible="{Binding Lines, Converter={x:Static v:Is.NotEmpty}}">
        <TextBlock Text="Total: " FontSize="{StaticResource FontSizeLg}" />
        <TextBlock x:Name="Total" Text="{Binding TotalLabel}" FontSize="{StaticResource FontSizeLg}" FontWeight="{StaticResource FontWeightBold}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
        <Button Classes="outlined" Content="Continue Shopping" Click="OnContinue" />
        <Button x:Name="BuyButton" Classes="buy" IsEnabled="{Binding !Buying}" Click="OnBuy"
                IsVisible="{Binding Lines, Converter={x:Static v:Is.NotEmpty}}">
          <Panel>
            <TextBlock Text="Buy" FontWeight="{StaticResource FontWeightSemibold}" IsVisible="{Binding !Buying}" />
            <TextBlock Text="Buying…" FontWeight="{StaticResource FontWeightSemibold}" IsVisible="{Binding Buying}" />
          </Panel>
        </Button>
      </StackPanel>
    </StackPanel>
  </Border>
</cube:ScopeView>
