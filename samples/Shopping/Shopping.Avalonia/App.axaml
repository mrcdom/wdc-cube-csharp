<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Shopping.Avalonia.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Border.card">
      <Setter Property="Background" Value="White" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="BoxShadow" Value="0 1 4 0 #22000000" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#6B7280" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="#B91C1C" />
    </Style>
    <Style Selector="TextBlock.success">
      <Setter Property="Foreground" Value="#15803D" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.price">
      <Setter Property="Foreground" Value="#1D4ED8" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#2563EB" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.toast">
      <Setter Property="Background" Value="#B91C1C" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Margin" Value="16" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
  </Application.Styles>
</Application>
