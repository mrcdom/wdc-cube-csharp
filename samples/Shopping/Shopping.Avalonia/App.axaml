<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Shopping.Avalonia.App"
             RequestedThemeVariant="Light">
  <!-- The palette, sizes, radii and weights come from Tokens.axaml, generated from Design/tokens.json, as the web
       app's tokens.css: the two look the same. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Shopping.Avalonia/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- :: Text -->
    <Style Selector="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="{StaticResource FontSizeLg}" />
      <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{StaticResource Error}" />
    </Style>
    <Style Selector="TextBlock.price">
      <Setter Property="Foreground" Value="{StaticResource Price}" />
      <Setter Property="FontWeight" Value="{StaticResource FontWeightSemibold}" />
    </Style>

    <!-- :: Chip, card -->
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{StaticResource PrimaryContainer}" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.chip > TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontSizeXs}" />
      <Setter Property="FontWeight" Value="{StaticResource FontWeightMedium}" />
      <Setter Property="Foreground" Value="{StaticResource Primary}" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource Surface}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- :: Buttons: white with a thin line; primary, outlined, buy, on the header, remove -->
    <Style Selector="Button">
      <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
      <Setter Property="Background" Value="{StaticResource Surface}" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Hover}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Line}" />
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Surface}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="Opacity" Value="0.5" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource Primary}" />
      <Setter Property="BorderBrush" Value="{StaticResource Primary}" />
      <Setter Property="Foreground" Value="{StaticResource OnPrimary}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource PrimaryHover}" />
      <Setter Property="BorderBrush" Value="{StaticResource PrimaryHover}" />
      <Setter Property="Foreground" Value="{StaticResource OnPrimary}" />
    </Style>
    <Style Selector="Button.primary TextBlock">
      <Setter Property="Foreground" Value="{StaticResource OnPrimary}" />
    </Style>
    <!-- Disabled keeps its color, faded: the generic disabled look left the white text on a white button. -->
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Primary}" />
      <Setter Property="BorderBrush" Value="{StaticResource Primary}" />
    </Style>
    <Style Selector="Button.outlined">
      <Setter Property="BorderBrush" Value="{StaticResource Primary}" />
      <Setter Property="Foreground" Value="{StaticResource Primary}" />
    </Style>
    <Style Selector="Button.outlined:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{StaticResource Primary}" />
      <Setter Property="Foreground" Value="{StaticResource Primary}" />
    </Style>
    <Style Selector="Button.buy">
      <Setter Property="Background" Value="{StaticResource Price}" />
      <Setter Property="BorderBrush" Value="{StaticResource Price}" />
      <Setter Property="Foreground" Value="{StaticResource OnPrimary}" />
    </Style>
    <Style Selector="Button.buy:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource PriceHover}" />
      <Setter Property="BorderBrush" Value="{StaticResource PriceHover}" />
      <Setter Property="Foreground" Value="{StaticResource OnPrimary}" />
    </Style>
    <Style Selector="Button.buy TextBlock">
      <Setter Property="Foreground" Value="{StaticResource OnPrimary}" />
    </Style>
    <Style Selector="Button.buy:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Price}" />
      <Setter Property="BorderBrush" Value="{StaticResource Price}" />
    </Style>
    <Style Selector="Button.remove">
      <Setter Property="BorderBrush" Value="{StaticResource Error}" />
      <Setter Property="Foreground" Value="{StaticResource Error}" />
    </Style>
    <Style Selector="Button.remove:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{StaticResource Error}" />
      <Setter Property="Foreground" Value="{StaticResource Error}" />
    </Style>
    <Style Selector="Button.onPrimary">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource OnPrimaryLine}" />
      <Setter Property="Foreground" Value="{StaticResource OnPrimary}" />
    </Style>
    <Style Selector="Button.onPrimary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource OnPrimaryHover}" />
      <Setter Property="BorderBrush" Value="{StaticResource OnPrimaryLine}" />
      <Setter Property="Foreground" Value="{StaticResource OnPrimary}" />
    </Style>
    <Style Selector="Button.onPrimary TextBlock">
      <Setter Property="Foreground" Value="{StaticResource OnPrimary}" />
    </Style>
    <Style Selector="Button.logo">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource OnPrimary}" />
    </Style>
    <Style Selector="Button.logo:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource OnPrimary}" />
    </Style>

    <!-- Product and purchase cards: a white button with the line, content on the left -->
    <Style Selector="Button.product-card, Button.purchase-card">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="Button.purchase-card">
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- :: Inputs -->
    <Style Selector="TextBox">
      <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
      <Setter Property="Background" Value="{StaticResource Surface}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{StaticResource Surface}" />
      <Setter Property="BorderBrush" Value="{StaticResource Muted}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{StaticResource Surface}" />
      <Setter Property="BorderBrush" Value="{StaticResource Primary}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>

    <!-- :: Toast: dark, at the bottom, centred -->
    <Style Selector="Border.toast">
      <Setter Property="Background" Value="{StaticResource Toast}" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="Margin" Value="16,0,16,48" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.toast > TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
      <Setter Property="Foreground" Value="{StaticResource OnPrimary}" />
    </Style>

    <!-- :: Receipt table and cart lines: a line under each row -->
    <Style Selector="Border.row">
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="Border.success">
      <Setter Property="Background" Value="{StaticResource SuccessBg}" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Border.success > TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Price}" />
      <Setter Property="FontWeight" Value="{StaticResource FontWeightSemibold}" />
    </Style>
  </Application.Styles>
</Application>
