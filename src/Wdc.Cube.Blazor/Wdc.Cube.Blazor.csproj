    <Description>Blazor renderer for Cube scopes (Server and WebAssembly).</Description>
  </PropertyGroup>
  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Wdc.Cube/Wdc.Cube.csproj" />
