{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "**/*.csproj"
          ]
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.md",
          "**/toc.yml",
          "api/**.yml"
        ],
        "exclude": [
          "_site/**",
          "obj/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "Cube for .NET",
      "_appTitle": "Cube for .NET",
      "_enableSearch": true,
      "_gitContribute": {
        "repo": "https://github.com/mrcdom/wdc-cube-csharp",
        "branch": "main"
      },
      "_appLogoPath": "images/cube.svg",
      "_appFaviconPath": "images/cube.svg"
    },
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ]
  }
}
