{
  "$schema": "http://json.schemastore.org/template",
  "author": "WeDoCode",
  "classifications": ["Web", "Blazor", "Cube"],
  "identity": "Wdc.Cube.Templates.Blazor",
  "groupIdentity": "Wdc.Cube.Templates.Blazor",
  "name": "Cube application (Blazor Server, PostgreSQL)",
  "description": "A list of tasks with its detail: places, keys, presenters and scopes, drawn by Blazor Server and stored in PostgreSQL, with tests of the presenters and of the page.",
  "shortName": "cube-blazor",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "MyCubeApp",
  "preferNameDirectory": true,
  "symbols": {
    "Framework": {
      "type": "parameter",
      "description": "The target framework.",
      "datatype": "choice",
      "choices": [
        { "choice": "net10.0", "description": ".NET 10 (LTS)" },
        { "choice": "net11.0", "description": ".NET 11" }
      ],
      "defaultValue": "net10.0",
      "replaces": "net10.0"
    }
  },
  "sources": [
    {
      "modifiers": [
        { "exclude": ["**/bin/**", "**/obj/**", "**/TestResults/**", "**/.DS_Store"] }
      ]
    }
  ],
  "primaryOutputs": [
    { "path": "src/MyCubeApp.Blazor/MyCubeApp.Blazor.csproj" },
    { "path": "src/MyCubeApp.Presentation/MyCubeApp.Presentation.csproj" },
    { "path": "tests/MyCubeApp.Tests/MyCubeApp.Tests.csproj" }
  ]
}
