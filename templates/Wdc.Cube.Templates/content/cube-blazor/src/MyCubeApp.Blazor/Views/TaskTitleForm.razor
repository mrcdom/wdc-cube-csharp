@* The title being typed is the form's own state, started from the task's. *@
<form class="rename" @onsubmit="() => OnSave(_title)">
    <input @bind="_title" @bind:event="oninput" />
    <button type="submit">Save</button>
</form>

@code {
    private string _title = string.Empty;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public Func<string, Task> OnSave { get; set; } = _ => Task.CompletedTask;

    protected override void OnInitialized() => _title = Title;
}
