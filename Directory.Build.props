<Project>
  <!-- Configuração comum a todos os projetos. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <!-- Fixo para o mesmo fonte compilar igual nos dois alvos (net11 usaria C# 15 por padrão). -->
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <Version>0.1.0</Version>
    <Authors>WeDoCode Consultoria e Soluções Avançadas LTDA</Authors>
    <Company>WeDoCode Consultoria e Soluções Avançadas LTDA</Company>
    <Copyright>Copyright (c) 2017-2026 WeDoCode Consultoria e Soluções Avançadas LTDA</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/mrcdom/wdc-cube-csharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mrcdom/wdc-cube-csharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Relativo à raiz do repositório e com '/': as condições abaixo valem em qualquer pasta e no Windows. -->
    <WdcProjectPath>$([MSBuild]::MakeRelative($(MSBuildThisFileDirectory), $(MSBuildProjectDirectory)).Replace('\', '/'))/</WdcProjectPath>
  </PropertyGroup>

  <!-- Bibliotecas publicáveis (src/): compatíveis com trimming/AOT e documentadas. -->
  <PropertyGroup Condition="$(WdcProjectPath.StartsWith('src/'))">
    <IsPackable>true</IsPackable>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Membros públicos sem documentação não quebram o build. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>cube;presenter;mvp;navigation;blazor;avalonia;repository</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup Condition="$(WdcProjectPath.StartsWith('src/'))">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <PropertyGroup Condition="$(WdcProjectPath.StartsWith('samples/'))">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="$(WdcProjectPath.StartsWith('tests/')) or $(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
</Project>
